# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Skip API fetch during build (set to 'true' to skip)
SKIP_API_FETCH=false

# Keystatic CMS (GitHub backend)
KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
KEYSTATIC_SECRET=your_random_secret_string

# Patreon API (for content replication)
PATREON_ACCESS_TOKEN=your_patreon_access_token
PATREON_CAMPAIGN_ID=your_patreon_campaign_id

# Site URL (for RSS feed generation)
SITE_URL=https://bladimirsalazar.com